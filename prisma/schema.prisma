// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

datasource db {
  provider  = "postgresql"
  // DATABASE_URL is Neon's pooled (PgBouncer) endpoint — good for the app's
  // runtime queries in a serverless environment. Prisma Migrate needs a
  // direct, non-pooled connection for its advisory locks; running migrations
  // over the pooled endpoint on Vercel is what caused the P1002 timeout.
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---- People -----------------------------------------------------------
// slug is "ME" | "FRIEND" (see lib/types.ts) — plain String because SQLite
// doesn't support native enums.

model Profile {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  createdAt DateTime @default(now())

  // Inputs for BMR estimate + goal tracking.
  birthDate      DateTime?
  heightCm       Float?
  activityFactor Float?    @default(1.4) // multiplier applied to BMR -> TDEE
  startWeightKg  Float?
  goalWeightKg   Float?
  goalDate       DateTime? // trip date, e.g. 2027-03-01

  dailyCheckIns        DailyCheckIn[]
  weightLogs           WeightLog[]
  liftLogs             LiftLog[]
  cardioLogs           CardioLog[]
  workoutDayPlans      WorkoutDayPlan[]
  exerciseIncrements   ExerciseIncrement[]
  scheduleOverrides    ScheduleOverride[]
  scheduleTemplate     ScheduleTemplate[]
  mealPlanItemOverride MealPlanItemOverride[]
  foodLogs             FoodLog[]
  foodItemSwaps        FoodItemSwap[]
  mealPlanItemSwaps    MealPlanItemSwap[]
  customFoodItems      CustomFoodItem[]
  snackLogs            SnackLog[]
  foodLogCompletes     DailyFoodLogComplete[]

  @@map("profiles")
}

// ---- Daily check-in -----------------------------------------------------

model DailyCheckIn {
  id        String   @id @default(cuid())
  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  date      DateTime

  stuckToMealPlan    Boolean
  stuckToFitnessPlan Boolean
  sleepScore         Int? // 0-100, from wearable — no longer editable in the UI, kept for historical data
  recoveryScore      Int? // 0-100, from wearable — no longer editable in the UI, kept for historical data
  bmrReadingKcal     Int? // calories burned today, from wearable
  notes              String?

  createdAt DateTime @default(now())

  @@unique([profileId, date])
  @@map("daily_checkins")
}

// ---- Weekly weigh-in -----------------------------------------------------

model WeightLog {
  id        String   @id @default(cuid())
  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  date      DateTime
  weightKg  Float

  createdAt DateTime @default(now())

  @@unique([profileId, date])
  @@map("weight_logs")
}

// ---- Fitness: lifts -----------------------------------------------------

model LiftLog {
  id           String   @id @default(cuid())
  profileId    String
  profile      Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  date         DateTime
  exerciseName String
  sets         Json     @map("setsData") // array of { weightKg, reps }, one entry per set, in order performed

  createdAt DateTime @default(now())

  @@index([profileId, exerciseName, date])
  @@map("lift_logs")
}

// ---- Fitness: per-exercise weight increment override ---------------------
// Defaults to 5lb (see lib/overload.ts). Updated automatically whenever a
// logged weight for this exercise increases by a different amount, so future
// suggestions keep using whatever jump the user actually took.

model ExerciseIncrement {
  id           String   @id @default(cuid())
  profileId    String
  profile      Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  exerciseName String
  incrementLb  Float

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([profileId, exerciseName])
  @@map("exercise_increments")
}

// ---- Fitness: a profile's own list of workout days -----------------------
// Each profile owns a full, ordered list of gym-day variants (label +
// exercises), not just overrides on a fixed A1/B1/A2/B2 set — dayKey is a
// stable id (freely chosen, not a fixed enum) so profiles can rename days
// and add more of them (see lib/schedule.ts). sortOrder controls both
// display order and the round-robin rotation through the two-week schedule.
// exercises is a "\n"-joined list of exercise names, one per line.

model WorkoutDayPlan {
  id        String   @id @default(cuid())
  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  dayKey    String
  label     String
  exercises String
  sortOrder Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([profileId, dayKey])
  @@map("workout_day_plans")
}

// ---- Fitness: a profile's own two-week schedule template ------------------
// The repeating 14-day gym/run/bike cycle (see lib/schedule.ts) has a
// built-in default shape, but a profile can rearrange it slot by slot
// (slotIndex 0-13, one row per day of the two-week cycle) through the edit
// view — separate from ScheduleOverride below, which swaps one single date
// on the fly rather than the recurring pattern itself. dayType is
// "GYM" | "RUN" | "BIKE" | "REST".

model ScheduleTemplate {
  id        String   @id @default(cuid())
  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  slotIndex Int
  dayType   String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([profileId, slotIndex])
  @@map("schedule_templates")
}

// ---- Fitness: per-date schedule swaps -------------------------------------
// The two-week gym/run/bike cycle (see lib/schedule.ts) has a fixed default,
// but a specific date's type can be swapped on the fly (e.g. gym instead of
// a scheduled run). dayType is "GYM" | "RUN" | "BIKE" | "REST" | "OTHER".
// customLabel is only set when dayType is "OTHER" (e.g. "Swim") — a
// free-text day type available per-date only, not in the recurring template.

model ScheduleOverride {
  id          String   @id @default(cuid())
  profileId   String
  profile     Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  date        DateTime
  dayType     String
  customLabel String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([profileId, date])
  @@map("schedule_overrides")
}

// ---- Fitness: cardio (run / bike / row / swim) -----------------------------
// type is "RUN" | "BIKE" | "ROW" | "SWIM" (see lib/types.ts)

model CardioLog {
  id          String   @id @default(cuid())
  profileId   String
  profile     Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  date        DateTime
  type        String
  distanceKm  Float
  durationMin Float?

  createdAt DateTime @default(now())

  @@index([profileId, type, date])
  @@map("cardio_logs")
}

// ---- Nutrition: per-item serving size overrides ---------------------------
// The locked meal plan (see lib/nutrition.ts) has a baseline serving size for
// every item; any of them can be overridden per profile. day is "Monday".."Sunday",
// meal is "breakfast" | "lunch" | "dinner", groceryId matches the item's
// stable id there (e.g. "chickenThigh", "rice", "pasta").

model MealPlanItemOverride {
  id        String   @id @default(cuid())
  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  day       String
  meal      String
  groceryId String
  amountG   Float

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([profileId, day, meal, groceryId])
  @@map("meal_plan_item_overrides")
}

// ---- Nutrition: standing per-weekday item substitutions --------------------
// The weekday counterpart to FoodItemSwap below: swaps a meal-slot's item for
// an alternative on the STANDING plan for a weekday going forward (so it
// feeds the grocery list and becomes lunch/dinner's default on that weekday
// going forward), rather than just one specific date. day is "Monday".."Sunday".

model MealPlanItemSwap {
  id        String   @id @default(cuid())
  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  day       String
  meal      String
  slot      String
  groceryId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([profileId, day, meal, slot])
  @@map("meal_plan_item_swaps")
}

// ---- Nutrition: actual per-date food log -----------------------------------
// Distinct from MealPlanItemOverride above: that adjusts the standing plan
// for a weekday going forward (feeds the grocery list); this records what
// was actually eaten on one specific calendar date. groceryId matches the
// same stable ids used there.

model FoodLog {
  id        String   @id @default(cuid())
  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  date      DateTime
  meal      String // "breakfast" | "lunch" | "dinner"
  groceryId String
  amountG   Float

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([profileId, date, meal, groceryId])
  @@map("food_logs")
}

// ---- Nutrition: per-date item substitutions --------------------------------
// A logged item can be swapped for one of its alternatives (see MacroItem.slot
// / alternatives in lib/nutrition.ts) for one specific date — e.g. lunch's
// meat swapped from chicken thigh to salmon just for today. Distinct from
// FoodLog: this records WHICH food fills a slot, not how much of it was
// eaten. slot is a stable id ("yogurt" | "meat" | "carb"), independent of
// which groceryId happens to be the day's default.

model FoodItemSwap {
  id        String   @id @default(cuid())
  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  date      DateTime
  meal      String
  slot      String
  groceryId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([profileId, date, meal, slot])
  @@map("food_item_swaps")
}

// ---- Nutrition: user-defined foods -----------------------------------------
// A free-form food a profile has added themselves, with its P/F/C given for
// one specific reference weight (amountG) rather than normalized to 100g —
// state records whether that weight/macro reading is for the food raw or
// cooked. Not wired into the locked meal plan; lives on the Grocery page as
// a personal reference list.

model CustomFoodItem {
  id        String   @id @default(cuid())
  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  name      String
  amountG   Float
  state     String // "raw" | "cooked"
  proteinG  Float
  carbG     Float
  fatG      Float

  createdAt DateTime @default(now())

  @@map("custom_food_items")
}

// ---- Nutrition: snacks -----------------------------------------------------
// Ad-hoc extras logged for one specific date, on top of the fixed
// breakfast/lunch/dinner plan — pulled from the meal catalog, a saved
// CustomFoodItem, or typed in free-hand ("Other"). Unlike FoodLog, a snack
// isn't tied to a plan slot, so its resolved P/C/F is stored directly rather
// than a groceryId + amount to look a rate up by; amountG is kept only for
// display and is null for "Other" entries.

model SnackLog {
  id        String   @id @default(cuid())
  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  date      DateTime
  label     String
  amountG   Float?
  proteinG  Float
  carbG     Float
  fatG      Float

  createdAt DateTime @default(now())

  @@index([profileId, date])
  @@map("snack_logs")
}

// ---- Nutrition: "done logging for today" marker ----------------------------
// Just a presence flag, deliberately separate from DailyCheckIn — that
// model's stuckToMealPlan/stuckToFitnessPlan are required fields answered
// through the past-day check-in form, and auto-creating a row here shouldn't
// silently affect that form or the success-rate stats derived from it.

model DailyFoodLogComplete {
  id        String   @id @default(cuid())
  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  date      DateTime

  createdAt DateTime @default(now())

  @@unique([profileId, date])
  @@map("daily_food_log_complete")
}
