// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

datasource db {
  provider  = "postgresql"
  // DATABASE_URL is Neon's pooled (PgBouncer) endpoint — good for the app's
  // runtime queries in a serverless environment. Prisma Migrate needs a
  // direct, non-pooled connection for its advisory locks; running migrations
  // over the pooled endpoint on Vercel is what caused the P1002 timeout.
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---- People -----------------------------------------------------------
// slug is "ME" | "FRIEND" (see lib/types.ts) — plain String because SQLite
// doesn't support native enums.

model Profile {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  createdAt DateTime @default(now())

  // Inputs for BMR estimate + goal tracking.
  birthDate      DateTime?
  heightCm       Float?
  activityFactor Float?    @default(1.4) // multiplier applied to BMR -> TDEE
  startWeightKg  Float?
  goalWeightKg   Float?
  goalDate       DateTime? // trip date, e.g. 2027-03-01

  dailyCheckIns            DailyCheckIn[]
  weightLogs               WeightLog[]
  liftLogs                 LiftLog[]
  cardioLogs               CardioLog[]
  workoutDayPlans          WorkoutDayPlan[]
  exerciseIncrements       ExerciseIncrement[]
  scheduleOverrides        ScheduleOverride[]
  scheduleTemplate         ScheduleTemplate[]
  mealPlanItemOverride     MealPlanItemOverride[]
  athleticScheduleSettings AthleticScheduleSettings?
  googleCalendarConnection GoogleCalendarConnection?
  athleticCalendarEvents   AthleticCalendarEvent[]

  @@map("profiles")
}

// ---- Daily check-in -----------------------------------------------------

model DailyCheckIn {
  id        String   @id @default(cuid())
  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  date      DateTime

  stuckToMealPlan    Boolean
  stuckToFitnessPlan Boolean
  sleepScore         Int? // 0-100, from wearable — no longer editable in the UI, kept for historical data
  recoveryScore      Int? // 0-100, from wearable — no longer editable in the UI, kept for historical data
  bmrReadingKcal     Int? // calories burned today, from wearable
  notes              String?

  createdAt DateTime @default(now())

  @@unique([profileId, date])
  @@map("daily_checkins")
}

// ---- Weekly weigh-in -----------------------------------------------------

model WeightLog {
  id        String   @id @default(cuid())
  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  date      DateTime
  weightKg  Float

  createdAt DateTime @default(now())

  @@unique([profileId, date])
  @@map("weight_logs")
}

// ---- Fitness: lifts -----------------------------------------------------

model LiftLog {
  id           String   @id @default(cuid())
  profileId    String
  profile      Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  date         DateTime
  exerciseName String
  sets         Json     @map("setsData") // array of { weightKg, reps }, one entry per set, in order performed

  createdAt DateTime @default(now())

  @@index([profileId, exerciseName, date])
  @@map("lift_logs")
}

// ---- Fitness: per-exercise weight increment override ---------------------
// Defaults to 5lb (see lib/overload.ts). Updated automatically whenever a
// logged weight for this exercise increases by a different amount, so future
// suggestions keep using whatever jump the user actually took.

model ExerciseIncrement {
  id           String   @id @default(cuid())
  profileId    String
  profile      Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  exerciseName String
  incrementLb  Float

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([profileId, exerciseName])
  @@map("exercise_increments")
}

// ---- Fitness: a profile's own list of workout days -----------------------
// Each profile owns a full, ordered list of gym-day variants (label +
// exercises), not just overrides on a fixed A1/B1/A2/B2 set — dayKey is a
// stable id (freely chosen, not a fixed enum) so profiles can rename days
// and add more of them (see lib/schedule.ts). sortOrder controls both
// display order and the round-robin rotation through the two-week schedule.
// exercises is a "\n"-joined list of exercise names, one per line.

model WorkoutDayPlan {
  id        String   @id @default(cuid())
  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  dayKey    String
  label     String
  exercises String
  sortOrder Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([profileId, dayKey])
  @@map("workout_day_plans")
}

// ---- Fitness: a profile's own two-week schedule template ------------------
// The repeating 14-day gym/run/bike cycle (see lib/schedule.ts) has a
// built-in default shape, but a profile can rearrange it slot by slot
// (slotIndex 0-13, one row per day of the two-week cycle) through the edit
// view — separate from ScheduleOverride below, which swaps one single date
// on the fly rather than the recurring pattern itself. dayType is
// "GYM" | "RUN" | "BIKE" | "REST".

model ScheduleTemplate {
  id        String   @id @default(cuid())
  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  slotIndex Int
  dayType   String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([profileId, slotIndex])
  @@map("schedule_templates")
}

// ---- Fitness: per-date schedule swaps -------------------------------------
// The two-week gym/run/bike cycle (see lib/schedule.ts) has a fixed default,
// but a specific date's type can be swapped on the fly (e.g. gym instead of
// a scheduled run). dayType is "GYM" | "RUN" | "BIKE" | "REST".

model ScheduleOverride {
  id        String   @id @default(cuid())
  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  date      DateTime
  dayType   String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([profileId, date])
  @@map("schedule_overrides")
}

// ---- Fitness: cardio (run / bike) ----------------------------------------
// type is "RUN" | "BIKE" (see lib/types.ts)

model CardioLog {
  id          String   @id @default(cuid())
  profileId   String
  profile     Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  date        DateTime
  type        String
  distanceKm  Float
  durationMin Float?

  createdAt DateTime @default(now())

  @@index([profileId, type, date])
  @@map("cardio_logs")
}

// ---- Nutrition: per-item serving size overrides ---------------------------
// The locked meal plan (see lib/nutrition.ts) has a baseline serving size for
// every item; any of them can be overridden per profile. day is "Monday".."Sunday",
// meal is "breakfast" | "lunch" | "dinner", groceryId matches the item's
// stable id there (e.g. "chickenThigh", "rice", "pasta").

// ---- Athletic schedule -> Google Calendar sync ----------------------------
// The two-week gym/run/bike cycle above (ScheduleTemplate/ScheduleOverride)
// says WHAT type of day it is; these three models say WHEN things happen
// and where they land on Google Calendar. AthleticScheduleSettings holds the
// timing knobs (one row per profile). GoogleCalendarConnection holds the
// OAuth tokens for whichever Google account a profile has connected.
// AthleticCalendarEvent is a per-date registry of which Google event id
// corresponds to which locally-computed event, so the sync engine can
// create/update/delete precisely instead of guessing — see lib/calendarSync.ts.

model AthleticScheduleSettings {
  id        String  @id @default(cuid())
  profileId String  @unique
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  weekdayWakeTime String @default("05:00") // "HH:MM", applies Mon-Fri
  weekendWakeTime String @default("07:00") // Sat/Sun

  getReadyMin      Int @default(20)
  commuteToGymMin  Int @default(20)
  gymDurationMin   Int @default(60)
  runDurationMin   Int @default(60)
  showerMin        Int @default(15)

  // Keyed by Date#getUTCDay() as a string ("1".."5", Mon-Fri) -> minutes.
  // Weekend keys are absent — no commute-to-work event is generated for
  // Sat/Sun regardless of that day's schedule type.
  commuteToWorkMinByWeekday Json @default("{\"1\":20,\"2\":30,\"3\":30,\"4\":20,\"5\":20}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("athletic_schedule_settings")
}

model GoogleCalendarConnection {
  id        String  @id @default(cuid())
  profileId String  @unique
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  accessToken  String
  refreshToken String
  tokenExpiry  DateTime
  calendarId   String   @default("primary")
  timeZone     String   @default("America/New_York") // IANA zone, fetched from the connected calendar at connect-time

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("google_calendar_connections")
}

model AthleticCalendarEvent {
  id        String  @id @default(cuid())
  profileId String
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  date          DateTime
  kind          String // "ACTIVITY" | "COMMUTE"
  googleEventId String

  createdAt DateTime @default(now())

  @@unique([profileId, date, kind])
  @@map("athletic_calendar_events")
}

model MealPlanItemOverride {
  id        String   @id @default(cuid())
  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  day       String
  meal      String
  groceryId String
  amountG   Float

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([profileId, day, meal, groceryId])
  @@map("meal_plan_item_overrides")
}
